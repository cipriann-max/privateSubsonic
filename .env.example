# privateSubsonic server configuration
# Copy to .env and adjust. All values have sensible defaults for local dev.

# HTTP port the server listens on (Coolify/railpack default)
PORT=3000

# Log level: debug | info | warn | error
LOG_LEVEL=info

# NODE_ENV=production (default). `npm run dev` sets development, which is the
# only mode where the built UI (web/dist) is NOT served — Vite serves it instead.
# NODE_ENV=development
#
# Force serving web/dist from this server (auto | true | false). In development
# "auto" is false; set true to preview the production UI locally.
# SERVE_WEB=auto

# Users are managed in the app, not here. On first access the web UI asks you
# to create the admin account; that admin can then add and remove users. The
# users table in the SQLite database is the only source of authentication.

# SQLite file. Bind-mount a directory to /app/data in Docker and point this at it.
# Unused in v0.1 (no catalog DB) but bootstrapped so later versions can rely on it.
DATABASE_PATH=data/privatesubsonic.db

# In-memory LRU cache for Archive.org query results
CACHE_MAX_ENTRIES=500
CACHE_TTL_SECONDS=3600

# Provider selection (v0.1 ships exactly one)
PROVIDER=archive-org

# Outbound timeout in ms for provider HTTP calls
PROVIDER_TIMEOUT_MS=15000