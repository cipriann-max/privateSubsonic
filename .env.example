# privateSubsonic server configuration
# Copy to .env and adjust. All values have sensible defaults for local dev.

# HTTP port the server listens on
PORT=4533

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Single admin credential (OpenSubsonic token auth: salt + md5(password + salt))
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Salt used for the Subsonic token scheme (any random string; rotate to invalidate sessions)
AUTH_SALT=changesomerandomsalt

# SQLite file. Bind-mount a directory to /app/data in Docker and point this at it.
# Unused in v0.1 (no catalog DB) but bootstrapped so later versions can rely on it.
DATABASE_PATH=data/privatesubsonic.db

# In-memory LRU cache for Archive.org query results
CACHE_MAX_ENTRIES=500
CACHE_TTL_SECONDS=3600

# Provider selection (v0.1 ships exactly one)
PROVIDER=archive-org

# Outbound timeout in ms for provider HTTP calls
PROVIDER_TIMEOUT_MS=15000